{
  "port": 8090,
  "devMode": false,
  "bodyLimitBytes": 1048576,
  "defaultTimeoutMs": 120000,
  "maxConcurrency": 2,
  "shutdownGraceMs": 8000,
  "leaseDurationMs": 86400000,
  "reapIntervalMs": 300000,
  "githubSecretEnv": "GITHUB_WEBHOOK_SECRET",
  "slackWebhookEnv": "SLACK_WEBHOOK_URL",
  "stateDb": "state.sqlite",
  "reposRoot": "/home/dq/sonoran-checkouts",
  "worktreeRoot": "/home/dq/sonoran-worktrees",
  "allowlist": ["devils-17"],
  "requireLabel": "agent:ready",
  "workers": {
    "notify": {
      "program": "../slack-notify/slack-notify.sh",
      "args": ["pr-ready", "{{task}}", "--link", "{{link}}"]
    },
    "codex": {
      "program": "codex",
      "args": ["exec", "--full-auto", "{{prompt}}"],
      "createsTask": true,
      "allowedPaths": ["app/src/**", "native/**", "*.md"]
    }
  },
  "rules": [
    {
      "id": "pr-opened-notify",
      "when": { "events": ["pull_request"], "actions": ["opened"] },
      "worker": "notify",
      "authorize": "trusted"
    },
    {
      "id": "codex-on-ready-label",
      "when": { "events": ["issues", "pull_request"], "actions": ["labeled", "opened"] },
      "worker": "codex",
      "authorize": "label"
    }
  ]
}
