# Copy this file to .env (placed next to slack-notify.sh, or at the repo root)
# and fill in the values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# One webhook per project channel. Create it in Slack:
#   https://<your-workspace>.slack.com/apps/A0F7XDUAZ/incoming-webhooks
# or: Slack app -> Incoming Webhooks -> Add New Webhook to Workspace -> pick channel.

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_REAL_TOKEN

# Who is posting (used in the message headline).
AGENT_LABEL=codex

# Project display name + repo slug (for the message).
PROJECT_NAME=my-project
REPO_SLUG=myorg/my-project

# Optional: override the webhook's pinned channel.
SLACK_CHANNEL=

# Set to 1 to print the payload instead of posting (safe for testing).
DRY_RUN=0
