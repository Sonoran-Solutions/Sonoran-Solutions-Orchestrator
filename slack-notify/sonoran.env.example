# Sonoran orchestrator config — place OUTSIDE any task worktree at:
#   ~/.config/sonoran/orchestrator.env
#
# (or set $SONORAN_CONFIG_DIR to another directory, or set these as env vars,
#  which override this file.)
#
# Values are plain KEY=VALUE. They are parsed line-by-line and NEVER sourced or
# evaluated as shell, so there is no quoting/escaping to worry about.

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE_WITH_REAL_TOKEN

# Display name shown in the Slack message headline.
SONORAN_PROJECT=dualdex

# Optional: override the channel the incoming webhook is pinned to.
# SLACK_CHANNEL=#dual-dex

# Set to 1 to print the payload instead of posting (safe for testing).
# DRY_RUN=1
