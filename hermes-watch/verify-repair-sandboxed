#!/usr/bin/env bash
set -euo pipefail
repo=${1:?repo}; start=${2:?start}; branch=${3:?branch}
# The candidate checkout is read-only; all Git inspection occurs inside this
# network-disabled verifier namespace. No host home, state DB, or router tree is mounted.
exec bwrap --die-with-parent --unshare-all --ro-bind /usr /usr --ro-bind /bin /bin --ro-bind /sbin /sbin --ro-bind /lib /lib --ro-bind /lib64 /lib64 --ro-bind /etc /etc --proc /proc --dev /dev --tmpfs /tmp --tmpfs /home --ro-bind "$repo" /repo --chdir /repo --setenv HOME / --setenv GIT_CONFIG_GLOBAL /dev/null --setenv GIT_CONFIG_SYSTEM /dev/null -- /bin/sh -eu -c '
  branch=$(git branch --show-current); head=$(git rev-parse HEAD); git cat-file -e "$1^{commit}"; git merge-base --is-ancestor "$1" HEAD; [ "$head" != "$1" ]; status=$(git status --porcelain); files=$(git diff --name-only "$1..HEAD"); printf "BRANCH:%s\nHEAD:%s\nSTATUS_B64:%s\nFILES_B64:%s\n" "$branch" "$head" "$(printf %s "$status" | base64 -w0)" "$(printf %s "$files" | base64 -w0)"
' sh "$start" "$branch"
