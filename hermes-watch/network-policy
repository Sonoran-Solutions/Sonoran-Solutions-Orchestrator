#!/usr/bin/env bash
# Install the repair worker's fail-closed egress policy inside the private
# pasta-created user/network namespace, then enter the Bubblewrap sandbox.
set -euo pipefail

# pasta creates and owns this namespace. These rules therefore cannot affect
# the host, and Bubblewrap's nested user namespace does not own the network
# namespace and cannot modify this ruleset.
nft -f - <<'NFT'
flush ruleset
table inet sonoran_egress {
  chain output {
    type filter hook output priority 0; policy accept;

    ip daddr 0.0.0.0/8 reject
    ip daddr 10.0.0.0/8 reject
    ip daddr 100.64.0.0/10 reject
    ip daddr 127.0.0.0/8 reject
    ip daddr 169.254.0.0/16 reject
    ip daddr 172.16.0.0/12 reject
    ip daddr 192.168.0.0/16 reject

    ip6 daddr ::1 reject
    ip6 daddr fc00::/7 reject
    ip6 daddr fe80::/10 reject
  }
}
NFT

exec "$@"
